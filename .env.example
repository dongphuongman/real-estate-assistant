# AI Real Estate Assistant - Environment Variables
# Copy this file to .env and fill in your values
#
# Monorepo Structure (Vercel Full-Stack Deployment):
# - apps/web/    : Next.js frontend (port 3000)
# - apps/api/    : FastAPI backend (port 8000)
#
# Documentation Legend:
#   Local:    Settings for local development
#   GitHub:   Which GitHub Actions secret to configure
#   Vercel:   Where to set in Vercel dashboard
#   Docker:   Settings for Docker Compose deployment
#   VPS:      Settings for bare-metal VPS deployment
#
# SECURITY WARNINGS are marked with ⚠️

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# ENVIRONMENT - Application environment mode
#   Local:    development (default)
#   GitHub:   N/A (set in workflow)
#   Vercel:   Set to 'production' for production branch, 'preview' for PRs
#   Docker:   development or production
#   VPS:      production
#   Default:  development
ENVIRONMENT=development

# NODE_ENV - Node.js environment (for Next.js frontend)
#   Local:    development
#   Vercel:   Set automatically by Vercel
#   Default:  development
NODE_ENV=development

# FRONTEND_URL - Frontend URL for email links and CORS
#   Local:    http://localhost:3000
#   Vercel:   https://your-app.vercel.app
#   Docker:   http://localhost:3000
#   VPS:      https://your-domain.com
#   Default:  http://localhost:3000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# LLM PROVIDER API KEYS (at least one required)
# =============================================================================
# Configure at least one LLM provider for AI functionality.
# API keys are loaded from environment and never logged.

# OPENAI_API_KEY - OpenAI GPT-4/GPT-4o API key
#   Local:    Get from https://platform.openai.com/api-keys
#   GitHub:   Secret: OPENAI_API_KEY
#   Vercel:   Environment Variables → OPENAI_API_KEY
#   Security: Never commit real keys to git
OPENAI_API_KEY=sk-...

# ANTHROPIC_API_KEY - Anthropic Claude API key
#   Local:    Get from https://console.anthropic.com/settings/keys
#   GitHub:   Secret: ANTHROPIC_API_KEY
#   Vercel:   Environment Variables → ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# GOOGLE_API_KEY - Google Gemini API key
#   Local:    Get from https://aistudio.google.com/app/apikey
#   GitHub:   Secret: GOOGLE_API_KEY
#   Vercel:   Environment Variables → GOOGLE_API_KEY
GOOGLE_API_KEY=...

# XAI_API_KEY - xAI Grok API key
#   Local:    Get from https://console.x.ai/
#   GitHub:   Secret: XAI_API_KEY
#   Vercel:   Environment Variables → XAI_API_KEY
XAI_API_KEY=...

# DEEPSEEK_API_KEY - DeepSeek API key
#   Local:    Get from https://platform.deepseek.com/api_keys
#   GitHub:   Secret: DEEPSEEK_API_KEY
#   Vercel:   Environment Variables → DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=...

# ZAI_API_KEY - ZAI (Zhipu AI) API key - Chinese LLM provider with FREE tier
#   Local:    Get from https://open.bigmodel.cn/
#   GitHub:   Secret: ZAI_API_KEY
#   Vercel:   Environment Variables → ZAI_API_KEY
#   Features: Free tier (glm-4.7-flash), ultra-cheap production (glm-4.7-flashx)
#   Savings:  95%+ cheaper than OpenAI GPT-5.2
ZAI_API_KEY=...

# MOONSHOT_API_KEY - Moonshot AI (Kimi) API key - Chinese LLM with long context
#   Local:    Get from https://platform.moonshot.cn/
#   GitHub:   Secret: MOONSHOT_API_KEY
#   Vercel:   Environment Variables → MOONSHOT_API_KEY
#   Features: Up to 128K context, strong document analysis
#   Savings:  85%+ cheaper than OpenAI GPT-5.2
MOONSHOT_API_KEY=...

# DEFAULT_PROVIDER - Default LLM provider
#   Options:  openai, anthropic, google, xai, deepseek, zai, moonshot, ollama
#   Recommended for cost savings: zai (95%+ cheaper than OpenAI)
#   Default:  openai
DEFAULT_PROVIDER=openai

# DEFAULT_MODEL - Override default model for provider
#   Example:  gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro
#   Default:  Provider-specific default
# DEFAULT_MODEL=gpt-4o

# OLLAMA_DEFAULT_MODEL - Default model for Ollama (local LLM)
#   Local:    Set if using Ollama (requires OLLAMA_API_BASE)
#   Default:  llama3.2:3b
# OLLAMA_DEFAULT_MODEL=llama3.2:3b

# OLLAMA_API_BASE - Ollama API base URL (for local models)
#   Local:    http://localhost:11434 (if Ollama installed)
#   Docker:   http://ollama:11434 (with ollama service)
# OLLAMA_API_BASE=http://localhost:11434

# LLM_REQUEST_TIMEOUT_SECONDS - Timeout for LLM API requests
#   Local:    120 (2 minutes)
#   VPS:      Increase for slow connections (180-300)
#   Default:  120
# LLM_REQUEST_TIMEOUT_SECONDS=120

# LLM_CONNECT_TIMEOUT_SECONDS - Timeout for connecting to LLM APIs
#   Default:  30
# LLM_CONNECT_TIMEOUT_SECONDS=30

# =============================================================================
# API SECURITY (REQUIRED)
# =============================================================================
# ⚠️ SECURITY: No default fallback. All environments require explicit key.
# Generate a strong key: openssl rand -hex 32

# API_ACCESS_KEY - Primary API key for backend authentication
#   Local:    REQUIRED - Generate with: openssl rand -hex 32
#   GitHub:   Secret: API_ACCESS_KEY (for integration tests)
#   Vercel:   Environment Variables → API_ACCESS_KEY
#   Docker:   Set in deploy/compose/.env
#   VPS:      Set in /etc/real-estate-assistant/.env
#   Security: Never commit real keys to git
API_ACCESS_KEY=your-generated-api-key-here

# API_ACCESS_KEYS - Multiple API keys for rotation (comma-separated)
#   Format:   new-key,old-key (for zero-downtime rotation)
#   Default:  Uses API_ACCESS_KEY if not set
# API_ACCESS_KEYS=new-key,old-key

# API_ACCESS_KEY_SECONDARY - Secondary key for rotation
#   Usage:    Alternative to comma-separated API_ACCESS_KEYS
# API_ACCESS_KEY_SECONDARY=secondary-key-here

# API_RATE_LIMIT_ENABLED - Enable API rate limiting
#   Local:    true (helps test rate limiting)
#   Production: true (recommended)
#   Default:  true
# API_RATE_LIMIT_ENABLED=true

# API_RATE_LIMIT_RPM - Requests per minute per client
#   Default:  600 (10 per second)
#   VPS:      Lower if resources constrained (300)
# API_RATE_LIMIT_RPM=600

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# ⚠️ SECURITY: Production requires explicit origins (no wildcards)

# CORS_ALLOW_ORIGINS - Allowed CORS origins (comma-separated)
#   Local:    * (allows all) or http://localhost:3000
#   GitHub:   N/A (tests use test client)
#   Vercel:   https://your-app.vercel.app,https://studio.vercel.app
#   Docker:   http://localhost:3000
#   VPS:      https://your-domain.com
#   Production: REQUIRED - must be explicit list, no wildcards
#   Default:  * (development only)
# CORS_ALLOW_ORIGINS=http://localhost:3000

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Enable for user accounts, sessions, and protected features

# AUTH_JWT_ENABLED - Enable JWT-based user authentication
#   Local:    false (simpler development)
#   Production: true (if using user accounts)
#   Default:  false
# AUTH_JWT_ENABLED=true

# JWT_SECRET_KEY - Secret key for JWT token signing
#   Local:    REQUIRED if AUTH_JWT_ENABLED=true
#   GitHub:   Secret: JWT_SECRET_KEY
#   Vercel:   Environment Variables → JWT_SECRET_KEY
#   Security: Generate with: openssl rand -hex 32
#   Default:  None (required if JWT enabled)
# JWT_SECRET_KEY=your-jwt-secret-key-here

# JWT_ALGORITHM - JWT signing algorithm
#   Default:  HS256
# JWT_ALGORITHM=HS256

# JWT_ACCESS_TOKEN_EXPIRE_MINUTES - Access token lifetime
#   Local:    60 (convenient for development)
#   Production: 15 (short for security)
#   Default:  15
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# JWT_REFRESH_TOKEN_EXPIRE_DAYS - Refresh token lifetime
#   Default:  7
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE
# =============================================================================

# DATABASE_URL - Database connection URL
#   Local:    SQLite (default) or PostgreSQL
#   Docker:   postgresql+asyncpg://user:pass@postgres:5432/realestate
#   VPS:      postgresql+asyncpg://user:pass@localhost:5432/realestate
#   Vercel:   Postgres addon or external database
#   Default:  SQLite at ./data/auth.db
# DATABASE_URL=sqlite+aiosqlite:///./data/auth.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/realestate

# DB_POOL_SIZE - Database connection pool size
#   Local:    5 (lower for development)
#   Production: 10-20
#   Default:  10
# DB_POOL_SIZE=10

# DB_MAX_OVERFLOW - Max connections beyond pool size
#   Default:  20
# DB_MAX_OVERFLOW=20

# DB_POOL_TIMEOUT_SECONDS - Timeout for getting connection from pool
#   Default:  30
# DB_POOL_TIMEOUT_SECONDS=30

# DB_POOL_RECYCLE_SECONDS - Recycle connections after this time
#   Default:  3600 (1 hour)
# DB_POOL_RECYCLE_SECONDS=3600

# =============================================================================
# ACCOUNT LOCKOUT (Security - Task #47)
# =============================================================================

# AUTH_LOCKOUT_MAX_ATTEMPTS - Failed login attempts before lockout
#   Default:  5
#   Production: 3-5 recommended
# AUTH_LOCKOUT_MAX_ATTEMPTS=5

# AUTH_LOCKOUT_DURATION_MINUTES - Lockout duration
#   Default:  15
# AUTH_LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# OAUTH - GOOGLE
# =============================================================================

# AUTH_OAUTH_GOOGLE_ENABLED - Enable Google OAuth login
#   Local:    false (requires callback setup)
#   Production: true (if using Google Sign-In)
#   Default:  false
# AUTH_OAUTH_GOOGLE_ENABLED=true

# GOOGLE_CLIENT_ID - Google OAuth client ID
#   Get from: https://console.cloud.google.com/apis/credentials
#   GitHub:   Secret: GOOGLE_CLIENT_ID
#   Vercel:   Environment Variables → GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET - Google OAuth client secret
#   Get from: https://console.cloud.google.com/apis/credentials
#   GitHub:   Secret: GOOGLE_CLIENT_SECRET
#   Vercel:   Environment Variables → GOOGLE_CLIENT_SECRET
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# GOOGLE_REDIRECT_URI - OAuth callback URL
#   Local:    http://localhost:3000/api/v1/auth/oauth/callback
#   Vercel:   https://your-app.vercel.app/api/v1/auth/oauth/callback
#   Must match: Authorized redirect URI in Google Cloud Console
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/callback

# =============================================================================
# OAUTH - APPLE (Optional)
# =============================================================================

# AUTH_OAUTH_APPLE_ENABLED - Enable Apple Sign-In
#   Default:  false
# AUTH_OAUTH_APPLE_ENABLED=false

# APPLE_CLIENT_ID - Apple Services ID
# APPLE_CLIENT_ID=com.yourapp.web

# APPLE_TEAM_ID - Apple Developer Team ID
# APPLE_TEAM_ID=XXXXXXXXXX

# APPLE_KEY_ID - Apple Sign-In key ID
# APPLE_KEY_ID=XXXXXXXXXX

# APPLE_PRIVATE_KEY_PATH - Path to .p8 private key file
# APPLE_PRIVATE_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8

# =============================================================================
# EMAIL SETTINGS
# =============================================================================

# EMAIL_PROVIDER - Email sending provider
#   Options:  console (dev), smtp (production)
#   Local:    console (logs emails to console)
#   Production: smtp
#   Default:  console
# EMAIL_PROVIDER=console

# EMAIL_FROM_ADDRESS - Default sender email
#   Default:  noreply@example.com
# EMAIL_FROM_ADDRESS=noreply@example.com

# SMTP_HOST - SMTP server hostname
#   Gmail:    smtp.gmail.com
#   SendGrid: smtp.sendgrid.net
# SMTP_HOST=smtp.gmail.com

# SMTP_PORT - SMTP server port
#   Default:  587 (TLS)
# SMTP_PORT=587

# SMTP_USERNAME - SMTP authentication username
# SMTP_USERNAME=your.email@gmail.com

# SMTP_PASSWORD - SMTP authentication password
#   Gmail:    Use App Password (not regular password)
#   GitHub:   Secret: SMTP_PASSWORD
# SMTP_PASSWORD=your-app-specific-password

# SMTP_USE_TLS - Use TLS for SMTP connection
#   Default:  true
# SMTP_USE_TLS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# AUTH_REGISTRATION_ENABLED - Allow new user registration
#   Default:  true
# AUTH_REGISTRATION_ENABLED=true

# AUTH_EMAIL_VERIFICATION_REQUIRED - Require email verification
#   Default:  true (requires email setup)
# AUTH_EMAIL_VERIFICATION_REQUIRED=true

# INTERNET_ENABLED - Enable web search and fetch tools
#   Local:    false (optional)
#   Production: true (if using web research)
#   Default:  false
# INTERNET_ENABLED=false

# DATA_ENRICHMENT_ENABLED - Enable data enrichment features
#   Default:  false
# DATA_ENRICHMENT_ENABLED=false

# =============================================================================
# PUSH NOTIFICATIONS (Task #63)
# =============================================================================

# PUSH_ENABLED - Enable web push notifications
#   Local:    false
#   Production: true (if using notifications)
#   Default:  false
# PUSH_ENABLED=false

# VAPID_PUBLIC_KEY - VAPID public key for web push
#   Generate:  npx web-push generate-vapid-keys
#   Or Python: from pywebpush import generate_vapid_keys; generate_vapid_keys()
# VAPID_PUBLIC_KEY=

# VAPID_PRIVATE_KEY - VAPID private key for web push
#   GitHub:   Secret: VAPID_PRIVATE_KEY
#   Security: Never commit to git
# VAPID_PRIVATE_KEY=

# VAPID_SUBJECT - Contact email or URL for push notifications
#   Default:  mailto:noreply@example.com
# VAPID_SUBJECT=mailto:noreply@yourdomain.com

# =============================================================================
# GOOGLE ROUTES API (Commute Time Analysis - Task #21)
# =============================================================================

# GOOGLE_ROUTES_API_KEY - Google Routes API key for commute calculations
#   Get from:  https://developers.google.com/maps/routes
#   GitHub:    Secret: GOOGLE_ROUTES_API_KEY
#   Vercel:    Environment Variables → GOOGLE_ROUTES_API_KEY
# GOOGLE_ROUTES_API_KEY=your-google-routes-api-key-here

# GOOGLE_ROUTES_ENABLED - Enable commute time analysis
#   Default:  true (if API key provided)
# GOOGLE_ROUTES_ENABLED=true

# =============================================================================
# E-SIGNATURE INTEGRATION (Task #57)
# =============================================================================

# ESIGNATURE_ENABLED - Enable e-signature functionality
#   Default:  false
# ESIGNATURE_ENABLED=false

# ESIGNATURE_PROVIDER - E-signature provider
#   Options:  hellosign, docusign
#   Default:  hellosign
# ESIGNATURE_PROVIDER=hellosign

# HELLOSIGN_API_KEY - HelloSign (Dropbox Sign) API key
#   Get from:  https://app.hellosign.com
#   GitHub:    Secret: HELLOSIGN_API_KEY
# HELLOSIGN_API_KEY=your-hellosign-api-key

# HELLOSIGN_CLIENT_ID - HelloSign OAuth client ID (for embedded signing)
# HELLOSIGN_CLIENT_ID=your-client-id

# HELLOSIGN_WEBHOOK_SECRET - Secret for webhook signature verification
#   GitHub:    Secret: HELLOSIGN_WEBHOOK_SECRET
# HELLOSIGN_WEBHOOK_SECRET=your-webhook-secret

# ESIGNATURE_DEFAULT_EXPIRY_DAYS - Days until signature request expires
#   Default:  30
# ESIGNATURE_DEFAULT_EXPIRY_DAYS=30

# ESIGNATURE_REMINDER_ENABLED - Enable automatic reminders
#   Default:  true
# ESIGNATURE_REMINDER_ENABLED=true

# =============================================================================
# MCP CONNECTOR SETTINGS (Task #64)
# =============================================================================

# MCP_ENABLED - Enable MCP connector functionality
#   Default:  true
# MCP_ENABLED=true

# MCP_EDITION - MCP edition
#   Options:  community, pro, enterprise
#   Default:  community
# MCP_EDITION=community

# MCP_ALLOWLIST - Comma-separated list of allowed connectors
#   Default:  empty (all community connectors)
# MCP_ALLOWLIST=github,slack,linear

# MCP_DEFAULT_TIMEOUT_SECONDS - Default timeout for MCP operations
#   Default:  30
# MCP_DEFAULT_TIMEOUT_SECONDS=30

# MCP_POOL_MAX_CONNECTIONS - Max connections per connector pool
#   Default:  10
# MCP_POOL_MAX_CONNECTIONS=10

# MCP_DATA_MINIMIZATION_ENABLED - Enable PII stripping for MCP requests
#   Default:  true
# MCP_DATA_MINIMIZATION_ENABLED=true

# =============================================================================
# MCP AUDIT LOGGING (Task #69)
# =============================================================================

# MCP_AUDIT_LOGGING_ENABLED - Enable MCP connector audit logging
#   Description: Logs connector calls with PII redaction for security/audit
#   Local:    true
#   Production: true
#   Default:  true
# MCP_AUDIT_LOGGING_ENABLED=true

# MCP_AUDIT_LOG_DIR - Directory for MCP audit log files
#   Description: CSV files with connector call audit records
#   Local:    logs/mcp_audit
#   Docker:   /var/log/mcp_audit
#   VPS:      /var/log/real-estate-assistant/mcp_audit
#   Default:  logs/mcp_audit
# MCP_AUDIT_LOG_DIR=logs/mcp_audit

# MCP_AUDIT_RETENTION_DAYS - Days to retain MCP audit logs
#   Description: Logs older than this are automatically deleted
#   Local:    30
#   Production: 30-90 (depends on compliance requirements)
#   Default:  30
# MCP_AUDIT_RETENTION_DAYS=30

# =============================================================================
# CONTEXT WINDOW MANAGEMENT (Task #73)
# =============================================================================

# CONTEXT_MAX_UTILIZATION_PERCENT - Max context utilization before optimization
#   Description: Triggers optimization when context exceeds this percentage
#   Default:  75
# CONTEXT_MAX_UTILIZATION_PERCENT=75

# CONTEXT_SLIDING_WINDOW_MESSAGES - Number of recent messages to keep
#   Description: When sliding window is applied, keep this many messages
#   Default:  50
# CONTEXT_SLIDING_WINDOW_MESSAGES=50

# CONTEXT_SUMMARIZATION_THRESHOLD_PERCENT - Trigger summarization at this %
#   Description: Summarize old messages when approaching limit
#   Default:  80
# CONTEXT_SUMMARIZATION_THRESHOLD_PERCENT=80

# CONTEXT_COMPRESSION_ENABLED - Enable content compression
#   Description: Compress repeated/duplicate content in context
#   Default:  true
# CONTEXT_COMPRESSION_ENABLED=true

# CONTEXT_METRICS_ENABLED - Enable context usage metrics logging
#   Description: Log token usage and optimization stats
#   Default:  true
# CONTEXT_METRICS_ENABLED=true

# CONTEXT_PRIORITY_SYSTEM_WEIGHT - Weight for system messages (0.0-1.0)
#   Default:  1.0 (always include)
# CONTEXT_PRIORITY_SYSTEM_WEIGHT=1.0

# CONTEXT_PRIORITY_RECENT_WEIGHT - Weight decay for older messages (0.0-1.0)
#   Default:  0.8
# CONTEXT_PRIORITY_RECENT_WEIGHT=0.8

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================

# CACHE_ENABLED - Enable response caching
#   Local:    true (faster development)
#   Production: true (reduces API costs)
#   Default:  true
# CACHE_ENABLED=true

# CACHE_TTL_SECONDS - Cache time-to-live in seconds
#   Default:  300 (5 minutes)
# CACHE_TTL_SECONDS=300

# CACHE_REDIS_URL - Redis URL for distributed caching
#   Local:    empty (uses in-memory cache)
#   Docker:   redis://redis:6379
#   VPS:      redis://localhost:6379
#   Default:  empty (in-memory)
# CACHE_REDIS_URL=redis://localhost:6379

# CACHE_PREFIX - Cache key prefix for multi-tenant isolation
#   Default:  api_cache
# CACHE_PREFIX=api_cache

# CACHE_MAX_MEMORY_MB - Max memory for in-memory cache
#   Default:  100
# CACHE_MAX_MEMORY_MB=100

# CACHE_STALE_WHILE_REVALIDATE - Enable stale-while-revalidate pattern
#   Default:  false
# CACHE_STALE_WHILE_REVALIDATE=false

# =============================================================================
# METRICS & MONITORING
# =============================================================================

# METRICS_ENABLED - Enable application metrics collection
#   Default:  true
# METRICS_ENABLED=true

# METRICS_PATH - Path for metrics endpoint
#   Default:  /metrics
# METRICS_PATH=/metrics

# PROMETHEUS_ENABLED - Enable Prometheus metrics export
#   Local:    false
#   VPS:      true (if using Prometheus)
#   Default:  false
# PROMETHEUS_ENABLED=false

# =============================================================================
# WEB SEARCH & FETCH TOOLS
# =============================================================================

# SEARXNG_URL - SearXNG instance URL for web search
#   Local:    empty (disabled)
#   Docker:   http://searxng:8080 (with searxng service)
#   VPS:      http://localhost:8080
# SEARXNG_URL=

# WEB_SEARCH_MAX_RESULTS - Max results from web search
#   Default:  5
# WEB_SEARCH_MAX_RESULTS=5

# WEB_FETCH_TIMEOUT_SECONDS - Timeout for fetching web pages
#   Default:  10
# WEB_FETCH_TIMEOUT_SECONDS=10

# WEB_FETCH_MAX_BYTES - Max bytes to fetch from web pages
#   Default:  300000 (300KB)
# WEB_FETCH_MAX_BYTES=300000

# WEB_ALLOWLIST_DOMAINS - Comma-separated allowed domains for fetch
#   Default:  empty (all domains allowed)
# WEB_ALLOWLIST_DOMAINS=wikipedia.org,github.com

# =============================================================================
# CHAT SETTINGS
# =============================================================================

# CHAT_SOURCES_MAX_ITEMS - Max source items in chat response
#   Default:  5
# CHAT_SOURCES_MAX_ITEMS=5

# CHAT_SOURCE_CONTENT_MAX_CHARS - Max chars per source content
#   Default:  2000
# CHAT_SOURCE_CONTENT_MAX_CHARS=2000

# CHAT_SOURCES_MAX_TOTAL_BYTES - Max total bytes for sources payload
#   Default:  20000
# CHAT_SOURCES_MAX_TOTAL_BYTES=20000

# =============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION) SETTINGS
# =============================================================================

# RAG_MAX_FILES - Max files for RAG document upload
#   Default:  10
# RAG_MAX_FILES=10

# RAG_MAX_FILE_BYTES - Max bytes per file for RAG
#   Default:  10485760 (10MB)
# RAG_MAX_FILE_BYTES=10485760

# RAG_MAX_TOTAL_BYTES - Max total bytes for RAG upload
#   Default:  26214400 (25MB)
# RAG_MAX_TOTAL_BYTES=26214400

# =============================================================================
# REQUEST SIZE LIMITS
# =============================================================================

# REQUEST_MAX_BODY_SIZE_MB - Max request body size
#   Default:  10
# REQUEST_MAX_BODY_SIZE_MB=10

# REQUEST_MAX_UPLOAD_SIZE_MB - Max file upload size
#   Default:  25
# REQUEST_MAX_UPLOAD_SIZE_MB=25

# =============================================================================
# DATA SETTINGS
# =============================================================================

# VALUATION_MODE - Property valuation mode
#   Options:  simple, advanced
#   Default:  simple
# VALUATION_MODE=simple

# LEGAL_CHECK_MODE - Legal check mode
#   Options:  basic, comprehensive
#   Default:  basic
# LEGAL_CHECK_MODE=basic

# CRM_WEBHOOK_URL - Webhook URL for CRM integration
# CRM_WEBHOOK_URL=

# DEFAULT_DATASETS - Comma-separated default dataset URLs
# DEFAULT_DATASETS=

# =============================================================================
# VECTOR STORE CONFIGURATION
# =============================================================================

# CHROMA_PERSIST_DIR - ChromaDB persistence directory
#   Default:  ./chroma_db
# CHROMA_PERSIST_DIR=./vector_store/chroma

# =============================================================================
# REDIS (for caching, sessions, MCP)
# =============================================================================

# REDIS_URL - Redis connection URL
#   Local:    empty (not required)
#   Docker:   redis://redis:6379
#   VPS:      redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# =============================================================================
# UPTIME MONITOR (Optional)
# =============================================================================

# UPTIME_MONITOR_ENABLED - Enable uptime monitoring
#   Default:  false
# UPTIME_MONITOR_ENABLED=true

# UPTIME_MONITOR_HEALTH_URL - URL to check for health
# UPTIME_MONITOR_HEALTH_URL=http://localhost:8000/health

# UPTIME_MONITOR_EMAIL_TO - Email for alerts
# UPTIME_MONITOR_EMAIL_TO=ops@example.com

# UPTIME_MONITOR_INTERVAL - Check interval in seconds
# UPTIME_MONITOR_INTERVAL=60

# UPTIME_MONITOR_FAIL_THRESHOLD - Failures before alert
# UPTIME_MONITOR_FAIL_THRESHOLD=3

# UPTIME_MONITOR_COOLDOWN_SECONDS - Cooldown between alerts
# UPTIME_MONITOR_COOLDOWN_SECONDS=1800

# =============================================================================
# BACKEND API URL (Local Development Only)
# =============================================================================
# For Vercel full-stack deployment, this is NOT needed.
# The Next.js API proxy forwards requests automatically.

# BACKEND_API_URL - Backend API URL for Next.js proxy
#   Local:    http://localhost:8000/api/v1
