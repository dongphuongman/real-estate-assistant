{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "/api/v1"
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://realestate-api.onrender.com/api/v1/:path*"
    }
  ]
}
