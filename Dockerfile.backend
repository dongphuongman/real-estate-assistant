FROM python:3.12-slim-bookworm@sha256:d4ec434f6212e255e9362b68b4c3273c6fa51dc56c06915b1901b864efffe3a
WORKDIR /app
# Install dependencies with pinned versions for reproducibility
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
    && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
# Install uv for faster Python package management
COPY --from=ghcr.io/astral-sh/uv:latest@sha256:4f1c7d0746c7b22e0e63d598d45b214ddf633d6e1ae787789d0be9e3d981741 /uv /usr/local/bin/uv
COPY requirements.txt .
# Use uv to install dependencies (much faster than pip)
RUN uv pip install --system -r requirements.txt && \
    uv cache clean
COPY . .
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK CMD curl --fail http://localhost:8000/health || exit 1
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
